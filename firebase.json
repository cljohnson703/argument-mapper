{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "collab-site",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "database": { "port": 9000 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true }
  }
}
